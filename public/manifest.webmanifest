{
  "name": "Scanovix AI — Detect • Explain • Protect",
  "short_name": "Scanovix",
  "description": "AI scam and phishing detection for links, SMS, emails, QR codes and screenshots.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#050915",
  "theme_color": "#2563EB",
  "orientation": "portrait",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Smart Scan", "short_name": "Scan", "url": "/scan" },
    { "name": "History", "short_name": "History", "url": "/history" }
  ],
  "share_target": {
    "action": "/scan",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
